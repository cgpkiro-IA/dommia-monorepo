# Copy to .env.local and replace every placeholder. Never commit .env.local.
NODE_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dommia_admin
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=dommia_master
AUTH_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
RESIDENT_APP_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
RESIDENT_APP_URL=http://localhost:3004